{
  "name": "lovelace-ovapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "npm run versions && vite build && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts scripts/*.mjs",
    "format": "prettier --write src tests *.ts package.json tsconfig.json hacs.json scripts",
    "versions": "node scripts/check-versions.mjs",
    "test:versions": "node --test tests/tooling/*.test.mjs",
    "check": "npm run versions && npm run typecheck && npm run lint",
    "test": "npm run versions && npm run test:versions && vitest run",
    "test:coverage": "npm run versions && npm run test:versions && vitest run --coverage",
    "test:browser": "npm run build && playwright test",
    "harness": "vite --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
