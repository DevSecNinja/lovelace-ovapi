{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    "github>DevSecNinja/.github//.renovate/autoMerge.json5",
    "github>DevSecNinja/.github//.renovate/base.json5",
    "github>DevSecNinja/.github//.renovate/customManagers.json5",
    "github>DevSecNinja/.github//.renovate/groups.json5",
    "github>DevSecNinja/.github//.renovate/labels.json5",
    "github>DevSecNinja/.github//.renovate/packageRules.json5",
    "github>DevSecNinja/.github//.renovate/semanticCommits.json5",
  ],
  packageRules: [
    {
      description: "Node engines declare a supported range; .mise.toml owns the exact development pin.",
      matchManagers: ["npm"],
      matchDepTypes: ["engines"],
      matchPackageNames: ["node"],
      rangeStrategy: "replace",
    },
    {
      description: "TypeScript must remain within typescript-eslint's supported peer range; revisit with parser upgrades.",
      matchManagers: ["npm"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1.0",
    },
    {
      description: "Every pin in tests/ha-requirements.txt except homeassistant is an exact HA component-manifest requirement (scripts/check_ha_runtime.py enforces this), including home-assistant-frontend and home-assistant-intents. Renovate can't read HA's manifests, so it never proposes them on their own; update them from the new HA target's manifests on the HA target PR.",
      matchManagers: ["pip_requirements"],
      matchFileNames: ["tests/ha-requirements.txt"],
      matchPackageNames: ["!homeassistant"],
      enabled: false,
    },
    {
      description: "The HA target gets its own PR, outside the weekly all-non-major group: its manifest pins usually need a manual update on the branch, which must not block the other updates.",
      matchManagers: ["pip_requirements"],
      matchFileNames: ["tests/ha-requirements.txt"],
      matchPackageNames: ["homeassistant"],
      groupName: "Home Assistant target",
      groupSlug: "home-assistant-target",
    },
  ],
}
